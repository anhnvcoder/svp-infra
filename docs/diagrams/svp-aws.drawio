[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#60A337;gradientDirection=north;fillColor=#277116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.backup;" vertex="1" parent="1"><mxGeometry x="880" y="5400" width="80" height="80" as="geometry"/></mxCell><mxCell id="e_104" value="SHA-256, delete-object" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#277116;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="rlearner2" target="rmedia"><mxGeometry x="0.3" relative="1" as="geometry"/></mxCell><mxCell id="e_105" value="start-restore-job" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#277116;endArrow=blockThin;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rlearner2" target="rvault"><mxGeometry x="0.417" relative="1" as="geometry"><Array as="points"><mxPoint x="80" y="5340"/><mxPoint x="920" y="5340"/></Array></mxGeometry></mxCell><mxCell id="e_106" value="item-level restore of the key, role svp-&amp;lt;env&amp;gt;-backup" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#277116;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="rvault" target="rmedia"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t_107" value='&lt;ul style="margin:0;padding-left:16px"&gt;&lt;li&gt;S1 and R are digests of every table of video, engagement, feed: the row contents and xmin, so a restore at T_r matches S1 only if nothing was written between S1 and T_r&lt;/li&gt;&lt;li&gt;The instance svp-&amp;lt;env&amp;gt;-pitr is deleted when the drill ends; the application is not cut over to it in the drill&lt;/li&gt;&lt;li&gt;The restored object has a new ETag (AWS Backup does not keep it): the drill compares length and SHA-256 of the content&lt;/li&gt;&lt;/ul&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="240" y="5560" width="1520" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>