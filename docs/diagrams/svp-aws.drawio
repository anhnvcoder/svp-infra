e="1" parent="1" source="dlq" target="dlqalarm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_117" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#BC1356;endArrow=blockThin;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="dlqalarm" target="sns"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2120" y="1920"/><mxPoint x="1880" y="1920"/></Array></mxGeometry></mxCell><mxCell id="e_118" value="443" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8C4FFF;endArrow=blockThin;endFill=1;dashed=1;exitX=0;exitY=0.36363636363636365;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="eks" target="eni0"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="prd"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3720" pageHeight="3800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t_1" value="prd — EKS cluster svp-prd" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="920" height="40" as="geometry"/></mxCell><mxCell id="t_2" value="ap-southeast-1 · 3 AZs, each with a public (NAT gateway only), an edge (the internal ALB only), a private and a database subnet · one NAT gateway per AZ · system node group on-demand and Karpenter's nodes (on-demand), one icon each per AZ · API endpoint private only, reached through Systems Manager port forwarding to the SSM bastion · EBS volumes in the AZ of their pod's node · VPC flow logs, WAF logs and CloudFront access logs are written to S3 buckets of the svp-log-archive account" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=0;fontColor=#5A6C86;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="3640" height="40" as="geometry"/></mxCell><mxCell id="t_3" value="Database subnets, no route to the Internet: RDS Multi-AZ primary/standby · Amazon MSK one broker per AZ, SASL/SCRAM-SHA-512 over TLS · ElastiCache for Valkey primary and 1 replica(s), Multi-AZ, automatic failover · AWS picks the AZs of RDS and ElastiCache (drawn from the first) · CloudWatch alarms of RDS, MSK and ElastiCache notify an SNS topic encrypted with a customer managed key, which emails the learner · KMS, Secrets Manager, CloudWatch, SNS, SQS, EventBridge regional" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=0;fontColor=#5A6C86;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="3640" height="40" as="geometry"/></mxCell><mxCell id="t_4" value="Kubernetes: a frame per namespace, an icon per workload with its replicas · the scheduler puts each pod on any node of any AZ, so the row of a frame or an icon says nothing about where its pods run (svp is drawn across the first two AZs to show it) · third-party tools as text · EKS add-ons (CoreDNS, kube-proxy, VPC CNI) not drawn; the GuardDuty runtime agent add-on reports through the guardduty-data interface endpoint" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=0;fontColor=#5A6C86;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="3640" height="40" as="geometry"/></mxCell><mxCell id="g_5" value="AWS Cloud" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;fontColor=#232F3E;verticalAlign=top;align=left;spacingLeft=30;dashed=0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="160" y="160" width="3520" height="3600" as="geometry"/></mxCell><mxCell id="g_6" value="AWS Account svp