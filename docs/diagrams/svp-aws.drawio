tyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#BC1356;endArrow=blockThin;endFill=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="mcrule" target="dlq"><mxGeometry x="0.059" relative="1" as="geometry"><Array as="points"><mxPoint x="1440" y="2500"/><mxPoint x="1440" y="2600"/><mxPoint x="1720" y="2600"/><mxPoint x="1720" y="2500"/></Array></mxGeometry></mxCell><mxCell id="e_121" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#BC1356;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="dlq" target="dlqalarm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_122" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#BC1356;endArrow=blockThin;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="dlqalarm" target="sns"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2120" y="2400"/><mxPoint x="1880" y="2400"/></Array></mxGeometry></mxCell><mxCell id="e_123" value="443" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8C4FFF;endArrow=blockThin;endFill=1;dashed=1;exitX=0;exitY=0.23529411764705882;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="eks" target="eni0"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="org"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2840" pageHeight="2760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t_1" value="org — organization, accounts and security flows" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="920" height="40" as="geometry"/></mxCell><mxCell id="t_2" value="The management account holds the organization, IAM Identity Center and the organization trail · accounts in OUs as in the AWS Security Reference Architecture: Security (log archive, security tooling, backup) and Workloads (Prod, NonProd) · every account also runs the baseline (S3 Block Public Access, EBS default encryption, Config recorder to svp-config unless config_recording is off in aws/paid-features.json)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=0;fontColor=#5A6C86;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="2760" height="40" as="geometry"/></mxCell><mxCell id="t_3" value="Green: logs to the log archive account and backup copies to the backup account · red: detection and events to the security account, then SNS and email · policies on the root reach every member account (SCP, RCP) or every account (declarative, tag)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=0;fontColor=#5A6C86;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2760" height="40" as="geometry"/></mxCell><mxCell id="g_4" value="AWS Organization · root" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;strokeColor=#232F3E;fillColor=none;fontColor=#232F3E;verticalAlign=top;align=left;spacingLeft=30;dashed=0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="2760" height="2520" as="geometry"/></mxCell><mxCell id="b_5" value='&lt;b&gt;On the root: service control policies&lt;/b&gt;&lt;ul style="margin:0;padding-left:16px"&gt;&lt;li&gt;SCP &lt;b&gt;svp-deny-leave-organization&lt;/b&gt;&lt;/li&gt;&lt;li&gt;SCP &lt;b&gt;svp-protect-cloudtrail&lt;/b&gt;&lt;/li&gt;&lt;li&gt;SCP &lt;b&gt;svp-deny-other-regions&lt;/b&gt;&lt;/li&gt;&lt;li&gt;SCP &lt;b&gt;svp-protect-baseline&lt;/b&gt;&lt;/li&gt;&lt;li&gt;SCP &lt;b&gt;svp-deny-iam-users&lt;/b&gt;&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#5A6C86;align=left;verticalAlign=top;spacing=10;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="80" y="240" width="840" height="200" as="geometry"/></mxCell><mxCell id="b_6" value='&lt;b&gt;On the root: resource control, declarative, tag&lt;/b&gt;&lt;ul style="margin:0;padding-left:16px"&gt;&lt;li&gt;RCP &lt;b&gt;svp-data-perimeter&lt;/b&gt;&lt;/li&gt;&lt;li&gt;Declarative policy &lt;b&gt;svp-ec2-baseline&lt;/b&gt;&lt;/li&gt;&lt;li&gt;Tag policy &lt;b&gt;svp-tags&lt;/b&gt;&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#5A6C86;align=left;verticalAlign=top;spacing=10;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="960" y="240" width="840" height="200" as="geometry"/></mxCell><mxCell id="b_7" value='&lt;b&gt;Organization features&lt;/b&gt;&lt;ul style="margin:0;padding-left:16px"&gt;&lt;li&gt;Centralized root access: member accounts hold no root credentials&lt;/li&gt;&lt;li&gt;Delegated administrator svp-security: GuardDuty, Security Hub, Config, IAM Access Analyzer, Inspector (ECR scanning of every member account with inspector_ecr always)&lt;/li&gt;&lt;li&gt;Baseline roots apply from the management account through OrganizationAccountAccessRole&lt;/li&gt;&lt;li&gt;AWS Backup: cross-account backup and the RDS, S3 opt-in set here; backup policies by OU, no delegated administrator&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#5A6C86;align=left;verticalAlign=top;spacing=10;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1840" y="240" width="880" height="200" as="geometry"/></mxCell><mxCell id="g_8" value="Management account" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;fontColor=#CD2264;verticalAlign=top;align=left;spacingLeft=30;dashed=0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="80" y="560" width="600" height="1040" as="geometry"/></mxCell><mxCell id="g_9" value="OU Security" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;strokeColor=#5A6C86;fillColor=none;fontColor=#5A6C86;verticalAlign=top;align=left;spacingLeft=30;dashed=0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="760" y="560" width="880" height="2080" as="geometry"/></mxCell><mxCell id="g_10" value="svp-log-archive" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;fontColor=#CD2264;verticalAlign=top;align=left;spacingLeft=30;dashed=0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="800" y="640" width="800" height="880" as="geometry"/></mxCell><mxCell id="g_11" value="svp-security · delegated administrator" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;fontColor=#CD2264;verticalAlign=top;align=left;spacingLeft=30;dashed=0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="800" y="1560" width="800" height="520" as="geometry"/></mxCell><mxCell id="g_12" value="svp-backup" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;fontColor=#CD2264;verticalAlign=top;align=left;spacingLeft=30;dashed=0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="800" y="2160" width="800" height="440" as="geometry"/></mxCell><mxCell id="g_13" value="OU Workloads" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;strokeColor=#5A6C86;fillColor=none;fontColor=#5A6C86;verticalAlign=top;align=left;spacingLeft=30;dashed=0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="2000" y="560" width="720" height="2080" as="geometry"/></mxCell><mxCell id="g_14" value="OU Prod" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;strokeColor=#5A6C86;fillColor=none;fontColor=#5A6C86;verticalAlign=top;align=left;spacingLeft=30;dashed=0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="2040" y="600" width="640" height="880" as="geometry"/></mxCell><mxCell id="g_15" value="svp-prd" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;fontColor=#CD2264;verticalAlign=top;align=left;spacingLeft=30;dashed=0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="2080" y="680" width="560" height="720" as="geometry"/></mxCell><mxCell id="g_16" value="OU NonProd" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;strokeColor=#5A6C86;fillColor=none;fontColor=#5A6C86;verticalAlign=top;align=left;spacingLeft=30;dashed=0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="2040" y="1520" width="640" height="1080" as="geometry"/></mxCell><mxCell id="g_17" value="svp-stg" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;fontColor=#CD2264;verticalAlign=top;align=left;spacingLeft=30;dashed=0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="2080" y="1600" width="560" height="720" as="geometry"/></mxCell><mxCell id="t_18" value="&lt;b&gt;On OU Prod:&lt;/b&gt; SCP &lt;b&gt;svp-prod-guardrails&lt;/b&gt;, Backup policy &lt;b&gt;svp-backup-prd&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="2080" y="1400" width="560" height="40" as="geometry"/></mxCell><mxCell id="t_19" value="&lt;b&gt;On OU NonProd:&lt;/b&gt; Backup policy &lt;b&gt;svp-backup-stg&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="2080" y="2320" width="560" height="40" as="geometry"/></mxCell><mxCell id="orgs" value="AWS Organizations&lt;br&gt;root, OUs, member accounts" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#F54749;gradientDirection=north;fillColor=#C7131F;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.organizations;" vertex="1" parent="1"><mxGeometry x="320" y="720" width="80" height="80" as="geometry"/>