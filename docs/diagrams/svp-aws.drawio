="1800" y="1960" width="80" height="80" as="geometry"/></mxCell><mxCell id="dlqalarm" value="CloudWatch alarm&lt;br&gt;svp-stg-transcode-events-dlq" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C7131F;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.alarm;" vertex="1" parent="1"><mxGeometry x="2080" y="1960" width="80" height="80" as="geometry"/></mxCell><mxCell id="t_66" value='&lt;ul style="margin:0;padding-left:16px"&gt;&lt;li&gt;media-worker runs its mediaconvert command here (same image and release as the ffmpeg worker): Kafka video.uploaded in, MediaConvert jobs out, transcode.completed or transcode.failed back&lt;/li&gt;&lt;li&gt;MediaConvert reads uploads and writes media as the role; its job-state events (COMPLETE, ERROR) reach media-worker through EventBridge and SQS; an event EventBridge cannot deliver and a message media-worker cannot handle land in the DLQ, which pages through SNS&lt;/li&gt;&lt;li&gt;media-worker calls MediaConvert and SQS through the interface endpoints and S3 through the gateway endpoint; no NAT&lt;/li&gt;&lt;/ul&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="2320" y="1960" width="1160" height="160" as="geometry"/></mxCell><mxCell id="kms_up" value="KMS alias/svp-stg-uploads&lt;br&gt;SSE-KMS and Bucket Key&lt;br&gt;of S3 uploads" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#F54749;gradientDirection=north;fillColor=#C7131F;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" vertex="1" parent="1"><mxGeometry x="600" y="2360" width="80" height="80" as="geometry"/></mxCell><mxCell id="kms_bk" value="KMS alias/svp-stg-backup&lt;br&gt;key of the vault svp-stg" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#F54749;gradientDirection=north;fillColor=#C7131F;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" vertex="1" parent="1"><mxGeometry x="1000" y="2360" width="80" height="80" as="geometry"/></mxCell><mxCell id="bkrole" value="Role svp-stg-backup&lt;br&gt;managed policies of AWS Backup" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C7131F;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.role;" vertex="1" parent="1"><mxGeometry x="1560" y="2360" width="80" height="80" as="geometry"/></mxCell><mxCell id="bkvault" value="AWS Backup vault svp-stg&lt;br&gt;no lock" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#60A337;gradientDirection=north;fillColor=#277116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=top;verticalAlign=bottom;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.backup;" vertex="1" parent="1"><mxGeometry x="1920" y="2360" width="80" height="80" as="geometry"/></mxCell><mxCell id="bkalarm_job" value="CloudWatch alarm&lt;br&gt;svp-stg-backup-job-failed" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C7131F;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.alarm;" vertex="1" parent="1"><mxGeometry x="2240" y="2360" width="80" height="80" as="geometry"/></mxCell><mxCell id="bkalarm_copy" value="CloudWatch alarm&lt;br&gt;svp-stg-backup-copy-failed" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C7131F;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.alarm;" vertex="1" parent="1"><mxGeometry x="2520" y="2360" width="80" height="80" as="geometry"/></mxCell><mxCell id="t_67" value='&lt;ul style="margin:0;padding-left:16px"&gt;&lt;li&gt;Backup policy svp-backup-stg of the organization puts the plan svp-stg here: rule daily, cron(0 18 * * ? *) UTC, the RDS instance and the media and uploads buckets tagged Backup=daily are its selection, run as the role&lt;/li&gt;&lt;li&gt;Recovery points live 2 days here (emptied at the end of each session) and 2 days in the copy&lt;/li&gt;&lt;li&gt;Both alarms notify SNS svp-stg-alarms (ticket)&lt;/li&gt;&lt;/ul&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="2800" y="2360" width="680" height="160" as="geometry"/></mxCell><mxCell id="copyvault" value="AWS Backup vault svp-stg-copy&lt;br&gt;governance lock 1–7 days" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#60A337;gradientDirection=north;fillColor=#277116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.backup;" vertex="1" parent="1"><mxGeometry x="1920" y="3080" width="80" height="80" as="geometry"/></mxCell><mxCell id="kms_copy" value="KMS alias/svp-backup-copy&lt;br&gt;key of both copy vaults" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#F54749;gradientDirection=north;fillColor=#C7131F;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" vertex="1" parent="1"><mxGeometry x="1560" y="3080" width="80" height="80" as="geometry"/></mxCell><mxCell id="t_68" value="Only the management account writes to svp-backup (the learner has read-only SSO) · the vault access policy lets svp-stg copy into the vault and nothing else, so an administrator of the env cannot delete the copies" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=0;fontColor=#5A6C86;" vertex="1" parent="1"><mxGeometry x="240" y="3080" width="1160" height="80" as="geometry"/></mxCell><mxCell id="e_69" value="DNS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#232F3E;endArrow=blockThin;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="users" target="r53"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="80" y="560"/></Array></mxGeometry></mxCell><mxCell id="e_70" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5A30B5;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="users" target="cf_web"><mxGeometry relative="1" as="geometry"><Array as="po