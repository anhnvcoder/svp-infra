><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_100" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#BC1356;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="events" target="sqs"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="org"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2840" pageHeight="2600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t_1" value="org — organization, accounts and security flows" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="920" height="40" as="geometry"/></mxCell><mxCell id="t_2" value="The management account holds the organization, IAM Identity Center and the organization trail · accounts in OUs as in the AWS Security Reference Architecture: Security (log archive, security tooling) and Workloads (Prod, NonProd) · every account also runs the baseline (S3 Block Public Access, EBS default encryption, Config recorder to svp-config)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=0;fontColor=#5A6C86;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="2760" height="40" as="geometry"/></mxCell><mxCell id="t_3" value="Green: logs to the log archive account · red: detection and events to the security account, then SNS and email · policies on the root reach every member account (SCP, RCP) or every account (declarative, tag)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=0;fontColor=#5A6C86;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2760" height="40" as="geometry"/></mxCell><mxCell id="g_4" value="AWS Organization · root" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;strokeColor=#232F3E;fillColor=none;fontColor=#232F3E;verticalAlign=top;align=left;spacingLeft=30;dashed=0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="2760" height="2360" as="geometry"/></mxCell><mxCell id="b_5" value='&lt;b&gt;On the root: service control policies&lt;/b&gt;&lt;ul style="margin:0;padding-left:16px"&gt;&lt;li&gt;SCP &lt;b&gt;svp-deny-leave-organization&lt;/b&gt;&lt;/li&gt;&lt;li&gt;SCP &lt;b&gt;svp-protect-cloudtrail&lt;/b&gt;&lt;/li&gt;&lt;li&gt;SCP &lt;b&gt;svp-deny-other-regions&lt;/b&gt;&lt;/li&gt;&lt;li&gt;SCP &lt;b&gt;svp-protect-baseline&lt;/b&gt;&lt;/li&gt;&lt;li&gt;SCP &lt;b&gt;svp-deny-iam-users&lt;/b&gt;&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#5A6C86;align=left;verticalAlign=top;spacing=10;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="80" y="240" width="840" height="200" as="geometry"/></mxCell><mxCell id="b_6" value='&lt;b&gt;On the root: resource control, declarative, tag&lt;/b&gt;&lt;ul style="margin:0;padding-left:16px"&gt;&lt;li&gt;RCP &lt;b&gt;svp-data-perimeter&lt;/b&gt;&lt;/li&gt;&lt;li&gt;Declarative policy &lt;b&gt;svp-ec2-baseline&lt;/b&gt;&lt;/li&gt;&lt;li&gt;Tag policy &lt;b&gt;svp-tags&lt;/b&gt;&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#5A6C86;align=left;verticalAlign=top;spacing=10;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="960" y="240" width="840" height="200" as="geometry"/></mxCell><mxCell id="b_7" value='&lt;b&gt;Organization features&lt;/b&gt;&lt;ul style="margin:0;padding-left:16px"&gt;&lt;li&gt;Centralized root access: member accounts hold no root credentials&lt;/li&gt;&lt;li&gt;Delegated administrator svp-security: GuardDuty, Security Hub, Config, IAM Access Analyzer&lt;/li&gt;&lt;li&gt;Baseline roots apply from the management account through OrganizationAccountAccessRole&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#5A6C86;align=left;verticalAlign=top;spacing=10;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1840" y="240" width="880" height="200" as="geometry"/></mxCell><mxCell id="g_8" value="Management account" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;fontColor=#CD2264;verticalAlign=top;align=left;spacingLeft=30;dashed=0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="80" y="560" width="600" height="1040" as="geometry"/></mxCell><mxCell id="g_9" value="OU Security" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;strokeColor=#5A6C86;fillColor=none;fontColor=#5A6C86;verticalAlign=top;align=left;spacingLeft=30;dashed=0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="760" y="560" width="880" height="1560" as="geometry"/></mxCell><mxCell id="g_10" value="svp-log-archive" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;fontColor=#CD2264;verticalAlign=top;align=left;spacingLeft=30;dashed=0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="800" y="640" width="800" height="880" as="geometry"/></mxCell><mxCell id="g_11" value="svp-security · delegated administrator" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fo