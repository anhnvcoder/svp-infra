try x="0.375" relative="1" as="geometry"/></mxCell><mxCell id="e_88" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#277116;endArrow=blockThin;endFill=1;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="bplan" target="brds"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_89" value="selects by tag" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#277116;endArrow=blockThin;endFill=1;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="bplan" target="bmedia"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_90" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#277116;endArrow=blockThin;endFill=1;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="bplan" target="bup"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_91" value="backup jobs, role svp-&amp;lt;env&amp;gt;-backup" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#277116;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="bplan" target="bvault"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_92" value="encrypts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C7131F;endArrow=blockThin;endFill=1;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="bkey" target="bvault"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_93" value="copy job" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#277116;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="bvault" target="bcopy"><mxGeometry x="0.5" relative="1" as="geometry"/></mxCell><mxCell id="e_94" value="encrypts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C7131F;endArrow=blockThin;endFill=1;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="bckey" target="bcopy"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t_95" value='&lt;ul style="margin:0;padding-left:16px"&gt;&lt;li&gt;The plan comes from the Backup policy, so an administrator of the env account can read it, not change it&lt;/li&gt;&lt;li&gt;Recovery points live 2 days (stg) or 35 days (prd) in the vault of the env and are emptied at the end of each session; the copy is kept by the lock of the copy vault, which accepts copies from the env account only&lt;/li&gt;&lt;li&gt;A job that fails raises the alarms svp-&amp;lt;env&amp;gt;-backup-job-failed, -copy-failed on the SNS topic svp-&amp;lt;env&amp;gt;-alarms&lt;/li&gt;&lt;/ul&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="560" y="4680" width="1240" height="120" as="geometry"/></mxCell><mxCell id="t_96" value="Restore drills: PITR of RDS, one object of S3 media from a recovery point" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="4880" width="1400" height="40" as="geometry"/></mxCell><mxCell id="g_97" value="AWS Cloud · ap-southeast-1" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;fontColor=#232F3E;verticalAlign=top;align=left;spacingLeft=30;dashed=0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="160" y="4960" width="1680" height="840" as="geometry"/></mxCell><mxCell id="g_98" value="AWS Account svp-