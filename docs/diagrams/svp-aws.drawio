[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#F54749;gradientDirection=north;fillColor=#C7131F;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.xray;" vertex="1" parent="1"><mxGeometry x="2040" y="2640" width="80" height="80" as="geometry"/></mxCell><mxCell id="t_65" value='&lt;ul style="margin:0;padding-left:16px"&gt;&lt;li&gt;ECR, AMP, AMG, the application log group and the X-Ray settings are in the root of the account, so they outlive the session; keys alias/svp-prd-ecr and alias/svp-prd-observability&lt;/li&gt;&lt;li&gt;Collector and Prometheus agent write to AMP, CloudWatch Logs and X-Ray; nodes pull images from ECR, third-party images through its pull-through cache&lt;/li&gt;&lt;li&gt;Interface endpoints: private DNS, 443 from the VPC, ENIs in the private subnets of the first 3 AZ(s); GitHub, Sigstore, Telegram, upstream registries, the Pricing API and AMG still go through NAT&lt;/li&gt;&lt;/ul&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="2320" y="2640" width="1160" height="120" as="geometry"/></mxCell><mxCell id="acm" value="ACM · ALB certificate, ap-southeast-1&lt;br&gt;viewer certificates in us-east-1" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#F54749;gradientDirection=north;fillColor=#C7131F;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.certificate_manager_2;" vertex="1" parent="1"><mxGeometry x="2960" y="2200" width="80" height="80" as="geometry"/></mxCell><mxCell id="mcrole" value="Role svp-prd-mediaconvert&lt;br&gt;GetObject uploads/*, PutObject media/*" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C7131F;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.role;" vertex="1" parent="1"><mxGeometry x="600" y="2440" width="80" height="80" as="geometry"/></mxCell><mxCell id="mc" value="MediaConvert queue svp-prd&lt;br&gt;on-demand" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#F78E04;gradientDirection=north;fillColor=#D05C17;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elemental_mediaconvert;" vertex="1" parent="1"><mxGeometry x="960" y="2440" width="80" height="80" as="geometry"/></mxCell><mxCell id="mcrule" value="EventBridge rule&lt;br&gt;svp-prd-mediaconvert-job-state" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#F34482;gradientDirection=north;fillColor=#BC1356;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge;" vertex="1" parent="1"><mxGeometry x="1240" y="2440" width="80" height="80" as="geometry"/></mxCell><mxCell id="evq" value="SQS svp-prd-transcode-events&lt;br&gt;read by media-worker" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#F34482;gradientDirection=north;fillColor=#BC1356;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="1"><mxGeometry x="1520" y="2440" width="80" height="80" as="geometry"/></mxCell><mxCell id="dlq" value="SQS svp-prd-&lt;br&gt;transcode-events-dlq" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#F34482;gradientDirection=north;fillColor=#BC1356;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="1"><mxGeometry x="1800" y="2440" width="80" height="80" as="geometry"/></mxCell><mxCell id="dlqalarm" value="CloudWatch alarm&lt;br&gt;svp-prd-transcode-events-dlq" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C7131F;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.alarm;" vertex="1" parent="1"><mxGeometry x="2080" y="2440" width="80" height="80" as="geometry"/></mxCell><mxCell id="t_66" value='&lt;ul style="margin:0;padding-left:16px"&gt;&lt;li&gt;media-worker runs its mediaconvert command here (same image and release as the ffmpeg worker): Kafka video.uploaded in, MediaConvert jobs out, transcode.completed or transcode.failed back&lt;/li&gt;&lt;li&gt;MediaConvert reads uploads and writes media as the role; its job-state events (COMPLETE, ERROR) reach media-worker through EventBridge and SQS; an event EventBridge cannot deliver and a message media-worker cannot handle land in the DLQ, which pages through SNS&lt;/li&gt;&lt;li&gt;media-worker calls MediaConvert and SQS through the interface endpoints and S3 through the gateway endpoint; no NAT&lt;/li&gt;&lt;/ul&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="2320" y="2440" width="1160" height="160" as="geometry"/></mxCell><mxCell id="kms_up" value="KMS alias/svp-prd-uploads&lt;br&gt;SSE-KMS and Bucket Key&lt;br&gt;of S3 uploads" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#F54749;gradientDirection=north;fillColor=#C7131F;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" vertex="1" parent="1"><mxGeometry x="600" y="2840" width="80" height="80" as="geometry"/></mxCell><mxCell id="kms_bk" value="KMS alias/svp-prd-backup&lt;br&gt;key of the vault svp-prd" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#F54749;gradientDirection=north;fillColor=#C7131F;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" vertex="1" parent="1"><mxGeometry x="1000" y="2840" width="80" height="80" as="geometry"/></mxCell><mxCell id="bkrole" value="Role svp-prd-backup&lt;br&gt;managed policies of AWS Backup" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C7131F;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.role;" vertex="1" parent="1"><mxGeometry x="1560" y="2840" width="80" height="80" as="geometry"/></mxCell><mxCell id="bkvault" value="AWS Backup vault svp-prd&lt;br&gt;no lock" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#60A337;gradientDirection=north;fillColor=#277116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=top;verticalAlign=bottom;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.backup;" vertex="1" parent="1"><mxGeometry x="1920" y="2840" width="80" height="80" as="geometry"/></mxCell><mxCell id="bkalarm_job" value="CloudWatch alarm&lt;br&gt;svp-prd-backup-job-failed" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C7131F;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.alarm;" vertex="1" parent="1"><mxGeometry x="2240" y="2840" width="80" height="80" as="geometry"/></mxCell><mxCell id="bkalarm_copy" value="CloudWatch alarm&lt;br&gt;svp-prd-backup-copy-failed" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C7131F;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.alarm;" vertex="1" parent="1"><mxGeometry x="2520" y="2840" width="80" height="80" as="geometry"/></mxCell><mxCell id="t_67" value='&lt;ul style="margin:0;padding-left:16px"&gt;&lt;li&gt;Backup policy svp-backup-prd of the organization puts the plan svp-prd here: rule daily, cron(0 18 * * ? *) UTC, the RDS instance and the media and uploads buckets tagged Backup=daily are its selection, run as the role&lt;/li&gt;&lt;li&gt;Recovery points live 35 days here (emptied at the end of each session) and 35 days in the copy&lt;/li&gt;&lt;li&gt;Both alarms notify SNS svp-prd-alarms (ticket)&lt;/li&gt;&lt;/ul&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="2800" y="2840" width="680" height="160" as="geometry"/></mxCell><mxCell id="copyvault" value="AWS Backup vault svp-prd-copy&lt;br&gt;governance lock 7–35 days" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#60A337;gradientDirection=north;fillColor=#277116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.backup;" vertex="1" parent="1"><mxGeometry x="1920" y="3560" width="80" height="80" as="geometry"/></mxCell><mxCell id="kms_copy" value="KMS alias/svp-backup-copy&lt;br&gt;key of both copy vaults" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#F54749;gradientDirection=north;fillColor=#C7131F;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" vertex="1" parent="1"><mxGeometry x="1560" y="3560" width="80" height="80" as="geometry"/></mxCell><mxCell id="t_68" value="Only the management account writes to svp-backup (the learner has read-only SSO) · the vault access policy lets svp-prd copy into the vault and nothing else, so an administrator of the env cannot delete the copies" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=0;fontColor=#5A6C86;" vertex="1" parent="1"><mxGeometry x="240" y="3560" width="1160" height="80" as="geometry"/></mxCell><mxCell id="e_69" value="DNS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#232F3E;endArrow=blockThin;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="users" target="r53"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="80" y="560"/></Array></mxGeometry></mxCell><mxCell id="e_70" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5A30B5;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="users" target="cf_web"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="180" y="960"/><mxPoint x="180" y="920"/></Array></mxGeometry></mxCell><mxCell id="e_71" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5A30B5;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="users" target="cf_api"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="180" y="960"/><mxPoint x="180" y="1280"/></Array></mxGeometry></mxCell><mxCell id="e_72" value="VPC origin" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5A30B5;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="cf_web" target="alb"><mxGeometry x="0.086" relative="1" as="geometry"><Array as="points"><mxPoint x="520" y="920"/><mxPoint x="520" y="940"/></A