<mxfile host="build_svp.py" type="device"><diagram id="p1" name="stg"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2840" pageHeight="1920" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t_1" value="stg — EKS cluster svp-stg" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="920" height="40" as="geometry"/></mxCell><mxCell id="t_2" value="ap-southeast-1 · 2 AZs · one NAT gateway, in the first AZ, for every private subnet · managed node group Spot, one icon per AZ · RDS single-AZ (AWS picks the AZ; drawn in the first) · one NLB across all public subnets, made by the AWS Load Balancer Controller · EBS volumes in the AZ of their pod's node" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=0;fontColor=#5A6C86;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="2760" height="40" as="geometry"/></mxCell><mxCell id="t_3" value="Kubernetes: a frame per namespace, an icon per workload with its replicas · the scheduler puts each pod on any node of any AZ, so the row of a frame or an icon says nothing about where its pods run (svp is drawn across the first two AZs to show it) · third-party tools as text · EKS add-ons (CoreDNS, kube-proxy, VPC CNI) not drawn" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=0;fontColor=#5A6C86;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2760" height="40" as="geometry"/></mxCell><mxCell id="g_4" value="AWS Cloud · ap-southeast-1" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;fontColor=#232F3E;ver