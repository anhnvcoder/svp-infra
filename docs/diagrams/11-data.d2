# Overview of the data stores of an env (aws/envs/<env>/main.tf): the pods reach RDS, MSK and ElastiCache on one TLS
# port each with passwords from Secrets Manager, and the CloudWatch alarms of the three modules notify the topic of
# module alarms, outside the cluster.
vars: {
  d2-config: {
    layout-engine: elk
    pad: 20
  }
}
...@tokens

title: "Pod của env tới dữ liệu bằng đường nào, và ai báo khi dữ liệu sắp hỏng?" {
  shape: text
  near: top-center
  style: {font-size: 18; bold: true}
}

all: "" {
  grid-rows: 1
  grid-columns: 3
  grid-gap: 0
  style: {stroke: transparent; fill: transparent}
  env: "svp-stg · svp-prd (ap-southeast-1)" {
    class: account
    label.near: top-left
    grid-rows: 5
    grid-columns: 1
    grid-gap: 40

    r1: "" {
      grid-rows: 1
      grid-columns: 3
      grid-gap: 0
      style: {stroke: transparent; fill: transparent}
      secrets: "Mật khẩu" {
        class: prevention
        grid-rows: 3
        grid-gap: 24
        vertical-gap: 6
        s: "Secrets Manager · External\nSecrets" {class: sub}
        t: "không qua plan, không qua\nstate" {class: sub}
        r: "module rds · msk ·\nelasticache" {class: root}
      }
      sp1: "" {width: 140; style: {stroke: transparent; fill: transparent}}
      pods: "Pod của svp" {
        class: workload
        grid-rows: 2
        grid-gap: 24
        vertical-gap: 6
        s: "service · Job bootstrap ·\nKEDA · otelcol" {class: sub}
        r: "cluster EKS" {class: root}
      }
    }

    v1: "" {height: 70; style: {stroke: transparent; fill: transparent}}
    db: "subnet database, 2–3 AZ" {
      class: region
      label.near: top-left
      grid-rows: 1
      grid-columns: 3
      grid-gap: 50

      rds: "PostgreSQL" {
        class: data
        grid-rows: 3
        grid-gap: 24
        vertical-gap: 6
        s: "RDS for PostgreSQL 17" {class: sub}
        t: "mỗi service một database" {class: sub}
        r: "aws/modules/rds" {class: root}
      }
      msk: "Kafka" {
        class: data
        grid-rows: 3
        grid-gap: 24
        vertical-gap: 6
        s: "Amazon MSK · KRaft" {class: sub}
        t: "mỗi client một user SCRAM" {class: sub}
        r: "aws/modules/msk" {class: root}
      }
      valkey: "Cache và khoá" {
        class: data
        grid-rows: 3
        grid-gap: 24
        vertical-gap: 6
        s: "ElastiCache for Valkey" {class: sub}
        t: "mỗi client một user RBAC" {class: sub}
        r: "aws/modules/elasticache" {class: root}
      }
    }

    v2: "" {height: 30; style: {stroke: transparent; fill: transparent}}
    r3: "" {
      grid-rows: 1
      grid-columns: 3
      grid-gap: 0
      style: {stroke: transparent; fill: transparent}
      alarms: "CloudWatch alarm" {
        class: alerting
        grid-rows: 3
        grid-gap: 24
        vertical-gap: 6
        s: "svp-<env>-<alarm> · tag\nSeverity" {class: sub}
        t: "sống ngoài cluster" {class: sub}
        r: "alarms.tf của mỗi module" {class: root}
      }
      sp3: "" {width: 130; style: {stroke: transparent; fill: transparent}}
      sns: "Amazon SNS" {
        class: alerting
        grid-rows: 3
        grid-gap: 24
        vertical-gap: 6
        s: "topic svp-<env>-alarms" {class: sub}
        t: "mã hoá bằng KMS key của\nmodule" {class: sub}
        r: "aws/modules/alarms" {class: root}
      }
    }
  }
  esp: "" {width: 120; style: {stroke: transparent; fill: transparent}}
  ecol: "" {
    grid-rows: 2
    grid-columns: 1
    grid-gap: 0
    style: {stroke: transparent; fill: transparent}
    etop: "" {height: 645; style: {stroke: transparent; fill: transparent}}
    email: "Email cảnh báo" {
    class: workload
    grid-rows: 2
    grid-gap: 24
    vertical-gap: 6
    s: "ALARM rồi OK, alarm page kèm\nlink runbook" {class: sub}
    r: "alarm_email" {class: root}
  }
  }
}

all.env.r1.secrets -> all.env.r1.pods: "mật khẩu từng\nclient" {class: data-flow}
all.env.r1.pods -> all.env.db.rds: "5432 · TLS\nverify-full" {class: data-flow}
all.env.r1.pods -> all.env.db.msk: "9096 · SCRAM\ntrên TLS" {class: data-flow}
all.env.r1.pods -> all.env.db.valkey: "6379 · TLS" {class: data-flow}
all.env.db.rds -> all.env.r3.alarms: {class: data-flow}
all.env.db.msk -> all.env.r3.alarms: {class: data-flow}
all.env.db.valkey -> all.env.r3.alarms: {class: data-flow}
all.env.r3.alarms -> all.env.r3.sns: "ALARM, OK" {class: data-flow}
all.env.r3.sns -> all.ecol.email: {class: data-flow}
