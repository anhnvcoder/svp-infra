# What of an environment outlives the session's destroy and who uses it: the root aws/accounts/<env> calls the modules
# account-baseline (state bucket, KMS key, hosted zone, DNSSEC of prd), registry (ECR, pull-through cache, OIDC
# provider, CI roles), observability (AMP, log group, X-Ray, AMG by flag) and ci-plan-role; aws/envs/<env> finds them by
# name and alias. The parent DNS delegates aws.<domain> with NS records aws; the prd zone delegates stg.aws.<domain>.
vars: {
  d2-config: {
    layout-engine: elk
    pad: 20
  }
}
...@tokens

title: "Cái gì của stg, prd sống qua destroy của buổi, và ai dùng nó" {
  shape: text
  near: top-center
  style: {font-size: 18; bold: true}
}

all: "" {
  grid-rows: 1
  grid-columns: 2
  grid-gap: 80
  style: {stroke: transparent; fill: transparent}
  outside: "Ngoài AWS" {
    class: trust
    style: {font-size: 15; bold: true}
    label.near: top-left
    grid-rows: 2
    grid-columns: 1
    grid-gap: 40

    github: "GitHub Actions" {
      class: workload
      grid-rows: 2
      grid-gap: 24
      vertical-gap: 6
      s: "svp-backend, svp-frontend:\nimages.yml · svp-infra:\nplan.yml" {class: sub}
      r: "token OIDC, không access key" {class: sub}
    }
    parent: "DNS cha của <domain>" {
      class: governance
      grid-rows: 2
      grid-gap: 24
      vertical-gap: 6
      s: "4 bản ghi NS aws · bản ghi\nDS aws (prd ký)" {class: sub}
      r: "Cloudflare, việc tay" {class: sub}
    }
  }
  env: "svp-stg, svp-prd (mỗi account một bộ, sống suốt lab)" {
    class: account
    label.near: top-left
    grid-rows: 3
    grid-columns: 2
    grid-gap: 60

    ci: "Role CI" {
      class: prevention
      grid-rows: 3
      grid-gap: 24
      vertical-gap: 6
      s1: "IAM OIDC provider ·\nsvp-ci-ecr-* ·\nsvp-ci-terraform-plan" {class: sub}
      s2: "trust đúng một sub · phiên 1\ngiờ" {class: sub}
      r: "module registry,\nci-plan-role" {class: root}
    }

    registry: "Registry ECR" {
      class: data
      grid-rows: 3
      grid-gap: 24
      vertical-gap: 6
      s1: "repo phát hành IMMUTABLE ·\nrule pull-through cache" {class: sub}
      s2: "quét image cache: BASIC hay\nInspector theo cờ" {class: sub}
      r: "module registry" {class: root}
    }

    dns: "Zone Route 53" {
      class: governance
      grid-rows: 3
      grid-gap: 24
      vertical-gap: 6
      s1: "prd aws.<domain> uỷ quyền\nstg.aws.<domain>" {class: sub}
      s2: "CAA ở đỉnh · prd: DNSSEC,\nquery log" {class: sub}
      r: "module account-baseline" {class: root}
    }

    session: "Cluster và dịch vụ của buổi" {
      class: workload
      grid-rows: 2
      grid-gap: 24
      vertical-gap: 6
      s: "EKS, RDS, edge · dựng và gỡ\nmỗi buổi" {class: sub}
      r: "aws/envs/<env>,\naws/gitops/<env>" {class: root}
    }

    state: "State Terraform" {
      class: recovery
      grid-rows: 2
      grid-gap: 24
      vertical-gap: 6
      s: "bucket\nsvp-tfstate-<account>-<region>\n· KMS alias/svp-tfstate" {class: sub}
      r: "module account-baseline" {class: root}
    }

    obs: "Telemetry" {
      class: investigation
      grid-rows: 3
      grid-gap: 24
      vertical-gap: 6
      s1: "AMP · CloudWatch Logs ·\nX-Ray · AMG theo cờ" {class: sub}
      s2: "metric stg 31, prd 150 ngày;\nlog, span stg 7, prd 30" {class: sub}
      r: "module observability" {class: root}
    }
  }
}

all.outside.github -> all.env.ci: "AssumeRoleWithWebIdentity" {class: control-flow}
all.env.ci -> all.env.registry: "chép bản phát\nhành theo digest" {class: data-flow}
all.outside.parent -> all.env.dns: "uỷ quyền, chuỗi\ntin cậy" {class: control-flow}
all.env.registry -> all.env.session: "node kéo theo\ndigest" {class: data-flow}
all.env.session -> all.env.obs: "metric, log,\ntrace" {class: data-flow}
all.env.session -> all.env.state: "state của root\nbuổi" {class: data-flow}
