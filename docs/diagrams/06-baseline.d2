# How the baseline reaches every account and who cannot undo it: the providers of aws/baseline/providers.tf
# (management without a role, each member through OrganizationAccountAccessRole), one security-baseline module per
# account in main.tf, the EBS keys of ebs-key.tf, and the SCP svp-protect-baseline of aws/modules/org-policies.
# Config delivers to the bucket of aws/log-archive; the rules forward to the bus of aws/security.
vars: {
  d2-config: {
    layout-engine: elk
    pad: 20
  }
}
...@tokens

title: "Baseline tới từng account bằng đường nào, ai không gỡ được" {
  shape: text
  near: top-center
  style: {font-size: 18; bold: true}
}

all: "" {
  grid-rows: 1
  grid-columns: 3
  grid-gap: 70
  style: {stroke: transparent; fill: transparent}
  mgmt: "Management" {
    class: account
    label.near: top-left
    grid-rows: 2
    grid-columns: 1
    grid-gap: 40

    root: "Root aws/baseline" {
      class: workload
      grid-rows: 3
      grid-gap: 24
      vertical-gap: 6
      s1: "một provider, một lời gọi\nmodule mỗi account" {class: sub}
      s2: "baseline của management:\nphiên SSO, không role" {class: sub}
      r: "profile anhnv-sso" {class: root}
    }
    scp: "SCP svp-protect-baseline" {
      class: governance
      grid-rows: 2
      grid-gap: 24
      vertical-gap: 6
      s: "gắn root của tổ chức, không\náp lên management" {class: sub}
      r: "aws/org · module\norg-policies" {class: root}
    }
  }
  member: "Mỗi account thành viên" {
    class: account
    label.near: top-left
    grid-rows: 2
    grid-columns: 1
    grid-gap: 40

    role: "OrganizationAccountAccessRole" {
      class: governance
      grid-rows: 1
      grid-gap: 24
      s: "phiên svp-terraform; role\nduy nhất SCP miễn" {class: sub}
    }
    baseline: "Baseline của account" {
      class: prevention
      grid-rows: 3
      grid-gap: 24
      vertical-gap: 6
      s1: "S3 Block Public Access cấp\naccount" {class: sub}
      s2: "EBS mã hoá mặc định, hai\nregion; CMK alias/svp-ebs ở\nstg, prd" {class: sub}
      s3: "Config recorder theo cờ\nconfig_recording · rule\nsvp-security-*" {class: sub}
    }
  }
  extr: "" {
    grid-rows: 2
    grid-columns: 1
    grid-gap: 40
    style: {stroke: transparent; fill: transparent}
    bucket: "Bucket svp-config-…" {
      class: data
      grid-rows: 1
      grid-gap: 24
      s: "svp-log-archive,\nap-southeast-1" {class: sub}
    }
    bus: "Bus svp-security-events" {
      class: alerting
      grid-rows: 1
      grid-gap: 24
      s: "svp-security, ap-southeast-1" {class: sub}
    }
  }
}

all.mgmt.root -> all.member.role: "assume role" {class: control-flow}
all.member.role -> all.member.baseline: "áp" {class: control-flow}
all.mgmt.scp -> all.member.baseline: "chặn sửa, trừ\nrole đó" {class: control-flow}
all.member.baseline -> all.extr.bucket: "lịch sử cấu hình" {class: data-flow}
all.member.baseline -> all.extr.bus: "sự kiện bảo mật" {class: data-flow}
