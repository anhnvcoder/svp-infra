# How the baseline reaches every account and who cannot undo it: the providers of aws/baseline/providers.tf
# (management without a role, each member through OrganizationAccountAccessRole), one security-baseline module per
# account in main.tf, the EBS keys of ebs-key.tf, and the SCP svp-protect-baseline of aws/modules/org-policies.
# Config delivers to the bucket of aws/log-archive; the rules forward to the bus of aws/security.
vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    dark-theme-id: 200
    pad: 20
  }
}
...@tokens

direction: down

title: "Baseline tới từng account bằng đường nào, ai không gỡ được" {
  shape: text
  near: top-center
  style: {font-size: 18; bold: true}
}

mgmt: "Management" {
  class: account
  label.near: top-left

  root: "Root aws/baseline" {
    class: workload
    grid-rows: 3
    grid-gap: 24
    vertical-gap: 6
    s1: "một provider, một lời gọi module mỗi account" {class: sub}
    s2: "baseline của management: phiên SSO, không role" {class: sub}
    r: "profile anhnv-sso" {class: root}
  }
  scp: "SCP svp-protect-baseline" {
    class: governance
    grid-rows: 2
    grid-gap: 24
    vertical-gap: 6
    s: "gắn root của tổ chức, không áp lên management" {class: sub}
    r: "aws/org · module org-policies" {class: root}
  }
}

member: "Mỗi account thành viên" {
  class: account
  label.near: top-left

  role: "OrganizationAccountAccessRole" {
    class: governance
    grid-rows: 1
    grid-gap: 24
    s: "phiên svp-terraform; role duy nhất SCP miễn" {class: sub}
  }
  baseline: "Baseline của account" {
    class: prevention
    grid-rows: 3
    grid-gap: 24
    vertical-gap: 6
    s1: "S3 Block Public Access cấp account" {class: sub}
    s2: "EBS mã hoá mặc định, hai region; CMK alias/svp-ebs ở stg, prd" {class: sub}
    s3: "Config recorder theo cờ config_recording · rule svp-security-*" {class: sub}
  }
}

bucket: "Bucket svp-config-…" {
  class: data
  grid-rows: 1
  grid-gap: 24
  s: "svp-log-archive, ap-southeast-1" {class: sub}
}

bus: "Bus svp-security-events" {
  class: alerting
  grid-rows: 1
  grid-gap: 24
  s: "svp-security, ap-southeast-1" {class: sub}
}

mgmt.root -> member.role: "assume role" {class: control-flow}
member.role -> member.baseline: "áp" {class: control-flow}
mgmt.scp -> member.baseline: "chặn sửa, trừ role đó" {class: control-flow}
member.baseline -> bucket: "lịch sử cấu hình" {class: data-flow}
member.baseline -> bus: "sự kiện bảo mật" {class: data-flow}
