# Overview of the alert path of aws/security/alerts.tf: a GuardDuty finding of an env account reaches email by one of
# two branches, picked by the security_hub flag of that account in aws/paid-features.json. The rules, regions and
# roles are in security-finding-to-email.d2.
vars: {
  d2-config: {
    layout-engine: elk
    pad: 20
  }
}
...@tokens

title: "Finding của account env tới email: hai nhánh theo cờ security_hub" {
  shape: text
  near: top-center
  style: {font-size: 18; bold: true}
}

all: "" {
  grid-rows: 1
  grid-columns: 3
  grid-gap: 80
  style: {stroke: transparent; fill: transparent}
  env: "svp-stg · svp-prd" {
    class: account
    label.near: top-left
    grid-rows: 2
    grid-columns: 1
    grid-gap: 60
    hub: "Security Hub CSPM của account" {
      class: detection
      grid-rows: 2
      grid-gap: 24
      vertical-gap: 6
      c: "chỉ ở account bật nó" {class: sub}
      s: "nhận finding GuardDuty" {class: sub}
    }
    guardduty: "GuardDuty" {
      class: detection
      grid-rows: 2
      grid-gap: 24
      vertical-gap: 6
      s: "phát hiện nguy cơ trong\naccount" {class: sub}
      r: "member, hai region" {class: sub}
    }
  }
  security: "svp-security" {
    class: account
    label.near: top-left
    grid-rows: 2
    grid-columns: 2
    grid-gap: 60
    always: "Security Hub CSPM, aggregator" {
      class: detection
      grid-rows: 2
      grid-gap: 24
      vertical-gap: 6
      c: "gom finding từ account bật\nSecurity Hub" {class: sub}
      s: "HIGH, CRITICAL" {class: sub}
    }
    events: "EventBridge" {
      class: alerting
      grid-rows: 2
      grid-gap: 24
      vertical-gap: 6
      s: "lọc và chuyển tiếp finding" {class: sub}
      r: "bus mặc định của\nsvp-security" {class: sub}
    }
    off: "GuardDuty của delegated admin" {
      class: detection
      grid-rows: 2
      grid-gap: 24
      vertical-gap: 6
      c: "nhận finding của mọi member" {class: sub}
      s: "rule lấy account\nsecurity_hub = off, severity\n≥ 7" {class: sub}
    }
    sns: "Amazon SNS" {
      class: alerting
      grid-rows: 2
      grid-gap: 24
      vertical-gap: 6
      s: "gửi tới mọi subscription" {class: sub}
      r: "topic svp-security-alarms" {class: sub}
    }
  }
  ecol: "" {
    grid-rows: 2
    grid-columns: 1
    grid-gap: 0
    style: {stroke: transparent; fill: transparent}
    etop: "" {height: 200; style: {stroke: transparent; fill: transparent}}
    email: "Email cảnh báo" {
      class: workload
      grid-rows: 2
      grid-gap: 24
      vertical-gap: 6
      s: "một dòng mỗi finding, kèm\nlink runbook" {class: sub}
      r: "security_alert_email" {class: sub}
    }
  }
}

all.env.guardduty -> all.env.hub: "security_hub =\nalways" {class: data-flow}
all.env.hub -> all.security.always: {class: data-flow}
all.env.guardduty -> all.security.off: "mọi finding" {class: data-flow}
all.security.always -> all.security.events: {class: data-flow}
all.security.off -> all.security.events: {class: data-flow}
all.security.events -> all.security.sns: {class: data-flow}
all.security.sns -> all.ecol.email: {class: data-flow}
