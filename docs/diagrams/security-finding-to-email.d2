# One GuardDuty finding of a member account on its way to email: both rules of aws/security/alerts.tf, picked by the
# security_hub flag of that account in aws/paid-features.json.
vars: {
  d2-config: {
    theme-id: 0
    dark-theme-id: 200
  }
}
...@tokens

direction: down

title: "Một finding của account env tới email bằng đường nào" {
  shape: text
  near: top-center
  style: {font-size: 20; bold: true}
}

member: "Account thành viên, ví dụ svp-stg" {
  class: account
  label.near: top-left
  detector: "GuardDuty\nmember, 2 region" {class: detection}
  hub: "Security Hub CSPM\ncủa account, cờ always" {class: detection}
}

security: "svp-security, delegated admin" {
  class: account
  label.near: top-left
  home: "ap-southeast-1" {
    class: trust
    label.near: top-left
    guardduty: "GuardDuty\nfinding của member ở region nhà" {class: detection}
    hub: "Security Hub CSPM\naggregator, gom us-east-1" {class: detection}
    findings: "Rule svp-security-findings\nHIGH, CRITICAL, NEW, ACTIVE" {class: alerting}
    gdhome: "Rule svp-security-guardduty-findings\nseverity ≥ 7" {class: alerting}
    bus: "Bus svp-security-events" {class: alerting}
    notify: "Rule svp-security-notify" {class: alerting}
    topic: "SNS svp-security-alarms\nKMS alias/svp-security-alarms" {class: alerting}
  }
  east: "us-east-1" {
    class: trust
    label.near: top-left
    guardduty: "GuardDuty\nfinding của member ở us-east-1" {class: detection}
    gdeast: "Rule svp-security-guardduty-findings\nseverity ≥ 7" {class: alerting}
  }
}

email: "Hộp thư security_alert_email" {class: workload}

member.detector -> security.home.guardduty: "finding" {class: data-flow}
member.detector -> security.east.guardduty: "finding" {class: data-flow}
member.detector -> member.hub: "cờ security_hub always" {class: data-flow}
member.hub -> security.home.hub: "aggregator gom" {class: data-flow}
security.home.hub -> security.home.findings: "Security Hub Findings - Imported" {class: data-flow}
security.home.guardduty -> security.home.gdhome: "cờ security_hub off" {class: data-flow}
security.east.guardduty -> security.east.gdeast: "cờ security_hub off" {class: data-flow}
security.east.gdeast -> security.home.bus: "role svp-security-guardduty-forwarder" {class: data-flow}
security.home.bus -> security.home.notify {class: data-flow}
security.home.findings -> security.home.topic {class: data-flow}
security.home.gdhome -> security.home.topic {class: data-flow}
security.home.notify -> security.home.topic {class: data-flow}
security.home.topic -> email: "email một dòng" {class: data-flow}
