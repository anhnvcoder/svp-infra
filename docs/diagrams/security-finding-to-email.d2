# One GuardDuty finding of a member account on its way to email: both rules of aws/security/alerts.tf, picked by the
# security_hub flag of that account in aws/paid-features.json.
vars: {
  d2-config: {
    layout-engine: elk
    pad: 20
  }
}
...@tokens

title: "Một finding của account env tới email bằng đường nào" {
  shape: text
  near: top-center
  style: {font-size: 18; bold: true}
}

all: "" {
  grid-rows: 2
  grid-columns: 3
  grid-gap: 0
  style: {stroke: transparent; fill: transparent}
  mcol: "" {
    grid-rows: 2
    grid-columns: 1
    grid-gap: 0
    style: {stroke: transparent; fill: transparent}
    member: "Account thành viên, ví dụ svp-stg" {
      class: account
      label.near: top-left
      grid-rows: 3
      grid-columns: 1
      grid-gap: 40
      hub: "Security Hub CSPM\ncủa account, cờ always" {class: detection}
      msp: "" {height: 60; style: {stroke: transparent; fill: transparent}}
      detector: "GuardDuty\nmember, 2 region" {class: detection}
    }
    mfill: "" {style: {stroke: transparent; fill: transparent}}
  }
  gsp: "" {width: 210; style: {stroke: transparent; fill: transparent}}
  security: "svp-security, delegated admin" {
    class: account
    label.near: top-left
    grid-rows: 2
    grid-columns: 1
    grid-gap: 50
    home: "ap-southeast-1" {
      class: region
      label.near: top-left
      grid-rows: 3
      grid-columns: 3
      vertical-gap: 40
      horizontal-gap: 95
      hub: "Security Hub CSPM\naggregator, gom\nus-east-1" {class: detection}
      findings: "Rule\nsvp-security-findings\nHIGH, CRITICAL, NEW,\nACTIVE" {class: alerting}
      e1: "" {style: {stroke: transparent; fill: transparent}}
      guardduty: "GuardDuty\nfinding của member\nở region nhà" {class: detection}
      gdhome: "Rule\nsvp-security-guardduty-findings\nseverity ≥ 7" {class: alerting}
      topic: "SNS\nsvp-security-alarms\nKMS alias/svp-security-alarms" {class: alerting}
      bus: "Bus\nsvp-security-events" {class: alerting}
      notify: "Rule\nsvp-security-notify" {class: alerting}
      e2: "" {style: {stroke: transparent; fill: transparent}}
    }

    east: "us-east-1" {
      class: region
      label.near: bottom-left
      grid-rows: 1
      grid-columns: 3
      horizontal-gap: 95
      guardduty: "GuardDuty\nfinding của member\nở us-east-1" {class: detection}
      gdeast: "Rule\nsvp-security-guardduty-findings\nseverity ≥ 7, chuyển bằng role\nsvp-security-guardduty-forwarder" {class: alerting}
      e3: "" {style: {stroke: transparent; fill: transparent}}
    }
  }
  bl: "" {style: {stroke: transparent; fill: transparent}}
  bl2: "" {style: {stroke: transparent; fill: transparent}}
  ecol: "" {
    grid-rows: 2
    grid-columns: 2
    grid-gap: 0
    style: {stroke: transparent; fill: transparent}
    ev1: "" {height: 40; style: {stroke: transparent; fill: transparent}}
    ev2: "" {style: {stroke: transparent; fill: transparent}}
    esp: "" {width: 780; style: {stroke: transparent; fill: transparent}}
    email: "Hộp thư security_alert_email" {class: workload}
  }
}

all.mcol.member.detector -> all.security.home.guardduty: "finding" {class: data-flow}
all.mcol.member.detector -> all.security.east.guardduty: "finding" {class: data-flow}
all.mcol.member.detector -> all.mcol.member.hub: "cờ security_hub\nalways" {class: data-flow}
all.mcol.member.hub -> all.security.home.hub: "aggregator gom" {class: data-flow}
all.security.home.hub -> all.security.home.findings: "Security Hub\nFindings -\nImported" {class: data-flow}
all.security.home.guardduty -> all.security.home.gdhome: "cờ security_hub\noff" {class: data-flow}
all.security.east.guardduty -> all.security.east.gdeast: "cờ security_hub\noff" {class: data-flow}
all.security.east.gdeast -> all.security.home.bus: {class: data-flow}
all.security.home.bus -> all.security.home.notify: {class: data-flow}
all.security.home.findings -> all.security.home.topic: {class: data-flow}
all.security.home.gdhome -> all.security.home.topic: {class: data-flow}
all.security.home.notify -> all.security.home.topic: {class: data-flow}
all.security.home.topic -> all.ecol.email: "email một dòng" {class: data-flow}
