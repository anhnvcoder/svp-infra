# Overview of the VPC of an env (aws/modules/network, aws/modules/ssm-bastion, called by aws/envs/<env>): four subnet
# tiers, which way each kind of traffic leaves or enters, the SSM tunnel to the private API endpoint of EKS and the
# flow logs written to the bucket of the log archive account.
vars: {
  d2-config: {
    layout-engine: elk
    pad: 20
  }
}
...@tokens

title: "Một VPC env chia thành tầng nào, và mỗi đường ra vào đi qua đâu?" {
  shape: text
  near: top-center
  style: {font-size: 18; bold: true}
}

all: "" {
  grid-rows: 1
  grid-columns: 3
  grid-gap: 0
  style: {stroke: transparent; fill: transparent}
  env: "svp-stg · svp-prd (ap-southeast-1)" {
    class: account
    label.near: top-left
    grid-rows: 3
    grid-columns: 1
    grid-gap: 50

    topg: "" {
      grid-rows: 1
      grid-columns: 3
      grid-gap: 0
      style: {stroke: transparent; fill: transparent}
      cloudfront: "CloudFront" {
        class: workload
        grid-rows: 2
        grid-gap: 24
        vertical-gap: 6
        s: "web · api, qua VPC origin" {class: sub}
        r: "aws/modules/edge" {class: root}
      }
      tsp: "" {width: 120; style: {stroke: transparent; fill: transparent}}
      ssm: "Session Manager" {
        class: prevention
        grid-rows: 2
        grid-gap: 24
        vertical-gap: 6
        s: "phiên port forwarding, IAM\nquyết ai mở" {class: sub}
        r: "AWS-StartPortForwardingSessionToRemoteHost" {class: root}
      }
    }

    vsp: "" {height: 20; style: {stroke: transparent; fill: transparent}}
    vpc: "VPC svp-<env> · stg 2 AZ, prd 3 AZ" {
      class: region
      label.near: top-right
      grid-rows: 2
      grid-columns: 5
      horizontal-gap: 30
      vertical-gap: 70

      edge: "Tầng edge" {
        class: workload
        grid-rows: 2
        grid-gap: 24
        vertical-gap: 6
        s: "ALB internal · chỉ route\nlocal" {class: sub}
        r: "edge_subnet_ids" {class: root}
      }
      h1: "" {width: 80; style: {stroke: transparent; fill: transparent}}
      private: "Tầng private" {
        class: workload
        grid-rows: 3
        grid-gap: 24
        vertical-gap: 6
        s: "node, pod EKS · bastion SSM" {class: sub}
        t: "endpoint private của API EKS" {class: sub}
        r: "private_subnet_ids" {class: root}
      }
      h2: "" {width: 50; style: {stroke: transparent; fill: transparent}}
      public: "Tầng public" {
        class: workload
        grid-rows: 2
        grid-gap: 24
        vertical-gap: 6
        s: "chỉ NAT gateway: stg một,\nprd mỗi AZ" {class: sub}
        r: "single_nat_gateway" {class: root}
      }
      endpoints: "VPC endpoint" {
        class: prevention
        grid-rows: 3
        grid-gap: 24
        vertical-gap: 6
        s: "S3 gateway · interface tới\nAPI AWS" {class: sub}
        t: "policy: interface chỉ\naccount env, S3 chỉ bucket\nenv" {class: sub}
        r: "s3_endpoint_restricted" {class: root}
      }
      h3: "" {width: 80; style: {stroke: transparent; fill: transparent}}
      database: "Tầng database" {
        class: data
        grid-rows: 2
        grid-gap: 24
        vertical-gap: 6
        s: "RDS · MSK · Valkey · chỉ\nroute local" {class: sub}
        r: "database_subnet_ids" {class: root}
      }
      h4: "" {width: 50; style: {stroke: transparent; fill: transparent}}
      e1: "" {width: 10; style: {stroke: transparent; fill: transparent}}
    }
  }
  gsp: "" {width: 140; style: {stroke: transparent; fill: transparent}}
  extr: "" {
    grid-rows: 3
    grid-columns: 1
    grid-gap: 50
    style: {stroke: transparent; fill: transparent}
    learner: "Máy người học" {
      class: workload
      grid-rows: 2
      grid-gap: 24
      vertical-gap: 6
      s: "kubectl · script buổi ·\naws/gitops/<env>" {class: sub}
      r: "127.0.0.1:<api_tunnel_port>" {class: root}
    }
    internet: "Đích ngoài AWS" {
      class: workload
      grid-rows: 2
      grid-gap: 24
      vertical-gap: 6
      s: "GitHub · Sigstore · registry\nupstream" {class: sub}
      r: "qua Internet Gateway" {class: root}
    }
    log: "svp-log-archive" {
      class: account
      label.near: top-left
      flowlogs: "Flow log của VPC" {
        class: investigation
        grid-rows: 2
        grid-gap: 24
        vertical-gap: 6
        s: "mọi lưu lượng · Parquet" {class: sub}
        r: "svp-flowlogs-<log>-ap-southeast-1" {class: root}
      }
    }
  }
}

all.extr.learner -> all.env.topg.ssm: "tunnel" {class: data-flow}
all.env.topg.ssm -> all.env.vpc.private: "bastion → API ·\n443" {class: data-flow}
all.env.topg.cloudfront -> all.env.vpc.edge: {class: data-flow}
all.env.vpc.edge -> all.env.vpc.private: "tới pod Envoy" {class: data-flow}
all.env.vpc.private -> all.env.vpc.database: "5432 · 9096 ·\n6379" {class: data-flow}
all.env.vpc.private -> all.env.vpc.endpoints: "API AWS, S3" {class: data-flow}
all.env.vpc.private -> all.env.vpc.public: "0.0.0.0/0" {class: data-flow}
all.env.vpc.public -> all.extr.internet: {class: data-flow}
all.env.vpc -> all.extr.log.flowlogs: "flow log" {class: data-flow}
