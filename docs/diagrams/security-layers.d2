# Security in layers, a concept and not an API flow: governance and prevention guard every workload, then detection
# and investigation run side by side over it. The last line of each block is the Terraform roots that build the layer.
vars: {
  d2-config: {
    layout-engine: elk
    pad: 20
  }
}
...@tokens

title: "Sáu lớp bảo mật của svp và root dựng mỗi lớp" {
  shape: text
  near: top-center
  style: {font-size: 18; bold: true}
}

all: "" {
  grid-rows: 1
  grid-columns: 3
  grid-gap: 60
  style: {stroke: transparent; fill: transparent}
  gp: "" {
    grid-rows: 2
    grid-columns: 1
    grid-gap: 50
    style: {stroke: transparent; fill: transparent}
    governance: "Quản trị" {
      class: governance
      grid-rows: 2
      grid-gap: 24
      vertical-gap: 6
      s: "Organizations · SCP · RCP ·\nIdentity Center" {class: sub}
      r: "aws/org" {class: root}
    }
    prevention: "Phòng ngừa" {
      class: prevention
      grid-rows: 2
      grid-gap: 24
      vertical-gap: 6
      s: "IAM · KMS · S3 BPA · IMDSv2" {class: sub}
      r: "aws/org · aws/baseline" {class: root}
    }
  }
  workload: "Workload và tài nguyên AWS" {
    class: workload
    grid-rows: 2
    grid-gap: 24
    vertical-gap: 6
    s: "EKS · RDS · S3 · ECR của mọi\naccount" {class: sub}
    r: "aws/accounts/ENV ·\naws/envs/ENV" {class: root}
  }
  dl: "" {
    grid-rows: 2
    grid-columns: 2
    grid-gap: 60
    style: {stroke: transparent; fill: transparent}
    detection: "Phát hiện" {
      class: detection
      grid-rows: 3
      grid-gap: 24
      vertical-gap: 6
      s1: "GuardDuty · Inspector" {class: sub}
      s2: "Security Hub CSPM · Access\nAnalyzer" {class: sub}
      r: "aws/security" {class: root}
    }
    alerting: "Cảnh báo" {
      class: alerting
      grid-rows: 2
      grid-gap: 24
      vertical-gap: 6
      s: "EventBridge · SNS" {class: sub}
      r: "aws/security ·\naws/baseline" {class: root}
    }
    investigation: "Điều tra" {
      class: investigation
      grid-rows: 3
      grid-gap: 24
      vertical-gap: 6
      s: "CloudTrail · Config · Log\nArchive" {class: sub}
      r1: "aws/org · aws/baseline" {class: root}
      r2: "aws/log-archive" {class: root}
    }
    recovery: "Phục hồi" {
      class: recovery
      grid-rows: 2
      grid-gap: 24
      vertical-gap: 6
      s: "AWS Backup chéo account ·\nVault Lock" {class: sub}
      r: "aws/backup ·\naws/accounts/ENV" {class: root}
    }
  }
}

all.gp.governance -> all.gp.prevention: {class: control-flow}
all.gp.prevention -> all.workload: {class: control-flow}
all.workload -> all.dl.detection: {class: data-flow}
all.workload -> all.dl.investigation: {class: data-flow}
all.dl.detection -> all.dl.alerting: {class: data-flow}
all.dl.investigation -> all.dl.recovery: {class: data-flow}
