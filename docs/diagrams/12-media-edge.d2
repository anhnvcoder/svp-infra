# Overview of the way in and the media of an env (aws/envs/<env>: modules edge, waf, media, transcode): the viewer
# reaches every public name through CloudFront and its web ACL, uploads go straight to the uploads bucket, MediaConvert
# turns them into HLS in the media bucket, and the edge logs land in the log archive account.
vars: {
  d2-config: {
    layout-engine: elk
    pad: 20
  }
}
...@tokens

title: "Video đi từ lúc tải lên tới lúc người xem phát qua những chặng nào?" {
  shape: text
  near: top-center
  style: {font-size: 18; bold: true}
}

all: "" {
  grid-rows: 3
  grid-columns: 1
  grid-gap: 50
  style: {stroke: transparent; fill: transparent}
  viewer: "Trình duyệt" {
    class: workload
    grid-rows: 2
    grid-gap: 24
    vertical-gap: 6
    s: "<domain> · api.<domain> ·\nmedia.<domain>" {class: sub}
    r: "web, hls.js" {class: root}
  }
  env: "svp-stg · svp-prd" {
    class: account
    label.near: top-left
    grid-rows: 1
    grid-columns: 2
    grid-gap: 70

    home: "ap-southeast-1" {
      class: region
      label.near: top-left
      grid-rows: 2
      grid-columns: 2
      horizontal-gap: 85
      vertical-gap: 60

      uploads: "Bucket uploads" {
        class: data
        grid-rows: 3
        grid-gap: 24
        vertical-gap: 6
        s: "SSE-KMS · quét malware\nGuardDuty" {class: sub}
        t: "uploads/<video_id>, Deep\nArchive sau 30 ngày" {class: sub}
        r: "aws/modules/media" {class: root}
      }

      media: "Bucket media" {
        class: data
        grid-rows: 3
        grid-gap: 24
        vertical-gap: 6
        s: "media/ · premium/ · preview/" {class: sub}
        t: "chỉ distribution media đọc,\nqua OAC" {class: sub}
        r: "aws/modules/media" {class: root}
      }

      transcode: "Transcode" {
        class: workload
        grid-rows: 3
        grid-gap: 24
        vertical-gap: 6
        s: "MediaConvert queue svp-<env>\n· on-demand" {class: sub}
        t: "EventBridge → SQS, DLQ có\nalarm page" {class: sub}
        r: "aws/modules/transcode" {class: root}
      }

      app: "Ứng dụng trong VPC" {
        class: workload
        grid-rows: 3
        grid-gap: 24
        vertical-gap: 6
        s: "ALB internal · Envoy ·\ngateway · video-service" {class: sub}
        t: "media-worker mediaconvert\n(bridge)" {class: sub}
        r: "aws/modules/edge · eks" {class: root}
      }
    }

    edge: "Đường vào duy nhất" {
      class: prevention
      grid-rows: 3
      grid-gap: 24
      vertical-gap: 6
      s: "CloudFront ×3 · web ACL WAF\n×3 · cert ACM (us-east-1)" {class: sub}
      t: "media/ · preview/ công khai,\nmọi path khác cần URL ký" {class: sub}
      r: "aws/modules/edge · waf ·\nmedia" {class: root}
    }
  }
  log: "svp-log-archive (us-east-1)" {
    class: account
    label.near: top-left

    logs: "Log edge" {
      class: investigation
      grid-rows: 2
      grid-gap: 24
      vertical-gap: 6
      s: "log WAF mọi request · log\nchuẩn v2 web, api (media chỉ\nprd)" {class: sub}
      r: "aws/log-archive" {class: root}
    }
  }
}

all.viewer -> all.env.edge: "HTTPS" {class: data-flow}
all.viewer -> all.env.home.uploads: "POST form đã ký" {class: data-flow}
all.env.edge -> all.env.home.app: "VPC origin" {class: data-flow}
all.env.home.app -> all.env.home.transcode: "CreateJob, đọc\nSQS" {class: control-flow}
all.env.home.uploads -> all.env.home.transcode: "bản gốc" {class: data-flow}
all.env.home.transcode -> all.env.home.media: "HLS" {class: data-flow}
all.env.edge -> all.env.home.media: "OAC, GET" {class: data-flow}
all.env.edge -> all.log.logs: {class: data-flow}
