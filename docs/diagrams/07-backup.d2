# Where the copies of stg and prd live and who can delete them: the backup policies svp-backup-<env> of
# aws/modules/org-policies (rule daily, copy action), the vault, key and role of aws/accounts/<env>/backup.tf, the copy
# vaults with their governance locks and the key of aws/backup, applied from management through
# OrganizationAccountAccessRole (aws/backup/providers.tf).
vars: {
  d2-config: {
    layout-engine: elk
    pad: 20
  }
}
...@tokens

title: "Bản copy của stg, prd nằm ở đâu, ai xoá được" {
  shape: text
  near: top-center
  style: {font-size: 18; bold: true}
}

all: "" {
  grid-rows: 2
  grid-columns: 1
  grid-gap: 50
  style: {stroke: transparent; fill: transparent}
  mgmt: "Management" {
    class: account
    label.near: top-left
    grid-rows: 1
    grid-columns: 2
    grid-gap: 40

    policy: "Backup policy svp-backup-<env>" {
      class: governance
      grid-rows: 3
      grid-gap: 24
      vertical-gap: 6
      s1: "gắn OU Prod, NonProd · rule\ndaily 18:00 UTC" {class: sub}
      s2: "admin env đọc được plan,\nkhông sửa" {class: sub}
      r: "aws/org · module\norg-policies" {class: root}
    }
    root: "Root aws/backup" {
      class: workload
      grid-rows: 2
      grid-gap: 24
      vertical-gap: 6
      s: "qua\nOrganizationAccountAccessRole" {class: sub}
      r: "profile anhnv-sso" {class: root}
    }
  }
  low: "" {
    grid-rows: 1
    grid-columns: 2
    grid-gap: 90
    style: {stroke: transparent; fill: transparent}
    env: "svp-stg, svp-prd" {
      class: account
      label.near: top-left
      grid-rows: 1
      grid-columns: 2
      grid-gap: 80

      data: "RDS, bucket uploads, media" {
        class: data
        grid-rows: 2
        grid-gap: 24
        vertical-gap: 6
        s: "tag Backup=daily · sống theo\nbuổi" {class: sub}
        r: "aws/envs/<env>" {class: root}
      }
      vault: "Vault svp-<env>" {
        class: recovery
        grid-rows: 3
        grid-gap: 24
        vertical-gap: 6
        s1: "không lock · giữ stg 2, prd\n35 ngày" {class: sub}
        s2: "key alias/svp-<env>-backup ·\nrole svp-<env>-backup" {class: sub}
        r: "aws/accounts/<env>" {class: root}
      }
    }
    backup: "svp-backup" {
      class: account
      label.near: bottom-left
      grid-rows: 1
      grid-columns: 1
      grid-gap: 40

      copy: "Vault svp-<env>-copy" {
        class: recovery
        grid-rows: 3
        grid-gap: 24
        vertical-gap: 6
        s1: "Vault Lock governance: stg\n1–7, prd 7–35 ngày" {class: sub}
        s2: "key alias/svp-backup-copy ·\nadmin env không chạm được" {class: sub}
        r: "aws/backup" {class: root}
      }
    }
  }
}

all.mgmt.policy -> all.low.env.vault: "sinh plan\nsvp-<env>" {class: control-flow}
all.low.env.data -> all.low.env.vault: "recovery point" {class: data-flow}
all.low.env.vault -> all.low.backup.copy: "copy job, mã hoá\nlại" {class: data-flow}
all.mgmt.root -> all.low.backup.copy: "dựng, gỡ lock" {class: control-flow}
