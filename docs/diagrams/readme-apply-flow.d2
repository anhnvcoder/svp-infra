# The order the roots are applied in, one question: which root goes into which account, and what does it add. A block is
# a root; its colour is the function of what it builds (the same palette as the security layers).
vars: {
  d2-config: {
    layout-engine: elk
    pad: 20
  }
}
...@tokens

title: "Thứ tự áp: mỗi root áp vào account nào và dựng gì" {
  shape: text
  near: top-center
  style: {font-size: 18; bold: true}
}

all: "" {
  grid-rows: 2
  grid-columns: 1
  grid-gap: 70
  style: {stroke: transparent; fill: transparent}
  lasting: "Sống lâu, áp một lần, ở lại giữa các buổi" {
    class: group
    label.near: top-left
    grid-rows: 3
    grid-columns: 3
    grid-gap: 50
    bootstrap: "aws/bootstrap" {
      class: workload
      grid-rows: 3
      grid-gap: 24
      vertical-gap: 6
      a: "management" {class: root}
      w: "Bucket state · KMS key ·\nbudget · Cost Anomaly\nDetection" {class: sub}
    }

    github: "github" {
      class: workload
      grid-rows: 3
      grid-gap: 24
      vertical-gap: 6
      a: "management (state) ·\nGitHub" {class: root}
      w: "Repo · ruleset · environment\n· cài đặt GitHub" {class: sub}
    }

    org: "aws/org" {
      class: governance
      grid-rows: 3
      grid-gap: 24
      vertical-gap: 6
      a: "management" {class: root}
      w: "Organizations · OU · SCP ·\nRCP · Identity Center ·\ntrail" {class: sub}
    }

    baseline: "aws/baseline" {
      class: prevention
      grid-rows: 3
      grid-gap: 24
      vertical-gap: 6
      a: "mọi account (qua role)" {class: root}
      w: "S3 BPA · EBS mã hoá · Config" {class: sub}
    }

    security: "aws/security" {
      class: detection
      grid-rows: 3
      grid-gap: 24
      vertical-gap: 6
      a: "svp-security (qua role)" {class: root}
      w: "GuardDuty · Security Hub ·\nInspector · cảnh báo" {class: sub}
    }

    logarchive: "aws/log-archive" {
      class: investigation
      grid-rows: 3
      grid-gap: 24
      vertical-gap: 6
      a: "svp-log-archive (qua role)" {class: root}
      w: "Bucket log của tổ chức · KMS\nkey" {class: sub}
    }

    backup: "aws/backup" {
      class: recovery
      grid-rows: 3
      grid-gap: 24
      vertical-gap: 6
      a: "svp-backup (qua role)" {class: root}
      w: "Vault copy có Vault Lock" {class: sub}
    }

    accounts: "aws/accounts/ENV" {
      class: workload
      grid-rows: 3
      grid-gap: 24
      vertical-gap: 6
      a: "svp-stg · svp-prd" {class: root}
      w: "State · zone · ECR · AMP ·\nvault env" {class: sub}
    }
  }
  session: "Trong buổi, dựng rồi gỡ" {
    class: group
    label.near: top-left
    grid-rows: 1
    grid-columns: 2
    grid-gap: 70
    envs: "aws/envs/ENV" {
      class: data
      grid-rows: 3
      grid-gap: 24
      vertical-gap: 6
      a: "svp-ENV" {class: root}
      w: "VPC · EKS · RDS · MSK ·\nElastiCache · edge" {class: sub}
    }
    gitops: "aws/gitops/ENV" {
      class: workload
      grid-rows: 3
      grid-gap: 24
      vertical-gap: 6
      a: "cluster EKS của svp-ENV" {class: root}
      w: "Argo CD · ApplicationSet" {class: sub}
    }
  }
}

all.lasting.bootstrap -> all.lasting.github: {class: control-flow}
all.lasting.github -> all.lasting.org: {class: control-flow}
all.lasting.org -> all.lasting.logarchive: {class: control-flow}
all.lasting.logarchive -> all.lasting.security: {class: control-flow}
all.lasting.security -> all.lasting.baseline: {class: control-flow}
all.lasting.baseline -> all.lasting.backup: {class: control-flow}
all.lasting.backup -> all.lasting.accounts: {class: control-flow}
all.lasting.accounts -> all.session.envs: {class: control-flow}
all.session.envs -> all.session.gitops: {class: control-flow}
