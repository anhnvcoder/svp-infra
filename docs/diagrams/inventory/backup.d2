# Generated by make inventory from a mock plan of aws/backup: change ci/inventory.sh or the root, never this file.
vars: {d2-config: {layout-engine: elk; pad: 20}}
...@../tokens

title: "aws/backup: 8 tài nguyên trên account trống" {
  shape: text
  near: top-center
  style: {font-size: 18; bold: true}
}

all: "" {
  grid-rows: 1
  grid-columns: 2
  grid-gap: 40
  style: {stroke: transparent; fill: transparent}
  p1: "kms.tf · 2" {
    class: workload
    grid-rows: 1
    grid-columns: 1
    grid-gap: 24
    s1: "KMS · 2" {shape: image; icon: ../icons/kms.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
  }
  p2: "module.vaults · 6" {
    class: workload
    grid-rows: 1
    grid-columns: 1
    grid-gap: 24
    s1: "Backup · 6" {shape: image; icon: ../icons/backup.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
  }
}
