# Generated by make inventory from a mock plan of aws/security: change ci/inventory.sh or the root, never this file.
vars: {d2-config: {layout-engine: elk; pad: 20}}
...@../tokens

title: "aws/security: 57 tài nguyên trên account trống" {
  shape: text
  near: top-center
  style: {font-size: 18; bold: true}
}

all: "" {
  grid-rows: 2
  grid-columns: 3
  grid-gap: 40
  style: {stroke: transparent; fill: transparent}
  p1: "alerts.tf · 12" {
    class: workload
    grid-rows: 1
    grid-columns: 2
    grid-gap: 24
    s1: "EventBridge · 10" {shape: image; icon: ../icons/eventbridge.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
    s2: "IAM · 2" {shape: image; icon: ../icons/iam.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
  }
  p2: "config.tf · 5" {
    class: workload
    grid-rows: 1
    grid-columns: 2
    grid-gap: 24
    s1: "Config · 1" {shape: image; icon: ../icons/config.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
    s2: "IAM · 4" {shape: image; icon: ../icons/iam.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
  }
  p3: "guardduty.tf · 20" {
    class: workload
    grid-rows: 1
    grid-columns: 1
    grid-gap: 24
    s1: "GuardDuty · 20" {shape: image; icon: ../icons/guardduty.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
  }
  p4: "inspector.tf · 5" {
    class: workload
    grid-rows: 1
