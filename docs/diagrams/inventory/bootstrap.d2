# Generated by make inventory from a mock plan of aws/bootstrap: change ci/inventory.sh or the root, never this file.
vars: {d2-config: {layout-engine: elk; pad: 20}}
...@../tokens

title: "aws/bootstrap: 14 tài nguyên trên account trống" {
  shape: text
  near: top-center
  style: {font-size: 18; bold: true}
}

all: "" {
  grid-rows: 2
  grid-columns: 2
  grid-gap: 40
  style: {stroke: transparent; fill: transparent}
  p1: "budget.tf · 1" {
    class: workload
    grid-rows: 1
    grid-columns: 1
    grid-gap: 24
    s1: "Budgets · 1" {shape: image; icon: ../icons/budgets.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
  }
  p2: "cost.tf · 5" {
    class: workload
    grid-rows: 1
    grid-columns: 1
    grid-gap: 24
    s1: "Cost Explorer · 5" {shape: image; icon: ../icons/cost-explorer.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
  }
  p3: "state.tf · 8" {
    class: workload
    grid-rows: 1
    grid-columns: 2
    grid-gap: 24
    s1: "KMS · 2" {shape: image; icon: ../icons/kms.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
    s2: "S3 · 6" {shape: image; icon: ../icons/s3.svg; width: 48; height: 48; style: {font-color: "#1A1A1A"; font-size: 13; bold: false}}
  }
}
