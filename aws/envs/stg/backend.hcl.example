# Shape of aws/backend-stg.hcl, the partial backend configuration shared by every root of the stg account (not this
# directory). No key: each root passes its own at init. Written from the output of aws/accounts/stg, never by hand:
#   AWS_PROFILE=anhnv-stg terraform -chdir=../../accounts/stg output -raw backend_hcl > ../../backend-stg.hcl

# Read with:
#   AWS_PROFILE=anhnv-stg terraform init -reconfigure -backend-config=../../backend-stg.hcl -backend-config=key=aws/stg/terraform.tfstate
bucket       = "svp-tfstate-111111111111-ap-southeast-1"
region       = "ap-southeast-1"
encrypt      = true
kms_key_id   = "arn:aws:kms:ap-southeast-1:111111111111:key/00000000-0000-0000-0000-000000000000"
use_lockfile = true
