# Copy to stg.auto.tfvars (ignored by git) and fill in. Never commit the real values: the repository is public.
# The account id is not here: every command sets TF_VAR_account_id from SVP_AWS_STG_ACCOUNT_ID (README.md).

# Output zone_id of aws/accounts/stg, the zone of the stg account:
#   AWS_PROFILE=anhnv-stg terraform -chdir=../../accounts/stg output -raw zone_id
hosted_zone_id = "Z0123456789ABCDEFGHIJ"

# Name of that zone, without the trailing dot (the web is at the apex, the API at api.<this name>):
#   AWS_PROFILE=anhnv-stg aws route53 get-hosted-zone --id <hosted_zone_id> --region ap-southeast-1 --query HostedZone.Name --output text
domain = "stg.aws.svp.example"

# Let's Encrypt account of cert-manager.
acme_email = "you@svp.example"

# Address of the machine that runs kubectl, as a /32 (curl -s https://checkip.amazonaws.com).
eks_public_access_cidrs = ["192.0.2.10/32"]
