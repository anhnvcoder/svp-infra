# Copy to bootstrap.auto.tfvars (ignored by git) and fill in. Never commit the real values: the repository is public.
# The account id is not here: export TF_VAR_account_id after checking the account (README.md, step 1).
budget_emails    = ["you@svp.example"]
budget_limit_usd = 20
zone_name        = "aws.svp.example"
# Zones of the member accounts, delegated from zone_name: name_servers output of aws/accounts/<env> (README.md, step 6).
delegated_subdomains = {
  "stg.aws.svp.example" = ["ns-1.awsdns-00.org", "ns-2.awsdns-00.co.uk", "ns-3.awsdns-00.com", "ns-4.awsdns-00.net"]
}
