# Copy to org.auto.tfvars (ignored by git) and fill in. Never commit the real values: the repository is public.
# The management account id is not here: TF_VAR_account_id is set in each command from SVP_AWS_MGMT_ACCOUNT_ID.

# Root email of each member account: an address no AWS account uses, a closed or suspended one included.
account_emails = {
  stg         = "stg@svp.example"
  prd         = "prd@svp.example"
  log-archive = "log-archive@svp.example"
  security    = "security@svp.example"
  backup      = "backup@svp.example"
}

# User name in IAM Identity Center (top right of the AWS access portal).
sso_user_name = "<user>"

# sso_region of the SSO profile in ~/.aws/config (inside its [sso-session ...] block when it has one).
sso_region = "us-east-1"

# SECURITY alternate contact of every account: who AWS writes to about a security issue.
security_contact = {
  name          = "<name>"
  title         = "<title>"
  email_address = "security-contact@svp.example"
  phone_number  = "+00 000 000 000"
}
