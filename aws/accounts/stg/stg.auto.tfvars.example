# Copy to stg.auto.tfvars (ignored by git) and fill in. Never commit the real values: the repository is public.
# The account ids are not here: every command sets TF_VAR_account_id from SVP_AWS_STG_ACCOUNT_ID and
# TF_VAR_backup_account_id from SVP_AWS_BACKUP_ACCOUNT_ID (aws/accounts/README.md).
budget_emails    = ["you@svp.example"]
budget_limit_usd = 20
zone_name        = "stg.aws.svp.example"

# Outputs platform_admin_group_id and platform_viewer_group_id of aws/org (made-up ids below).
platform_admin_group_id  = "0000000000-00000000-0000-0000-0000-000000000001"
platform_viewer_group_id = "0000000000-00000000-0000-0000-0000-000000000002"
