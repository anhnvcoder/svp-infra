# Copy to prd.auto.tfvars (ignored by git) and fill in. Never commit the real values: the repository is public.
# The account id is not here: every command sets TF_VAR_account_id from SVP_AWS_PRD_ACCOUNT_ID (aws/accounts/README.md).
alarm_email      = "you@svp.example"
budget_emails    = ["you@svp.example"]
budget_limit_usd = 20
zone_name        = "aws.svp.example"

# The stg zone, delegated from this zone: the four name servers of the name_servers output of aws/accounts/stg.
# Leave it out until the baseline of stg is applied.
delegated_subdomains = {
  "stg.aws.svp.example" = ["ns-1.awsdns-00.org", "ns-2.awsdns-01.net", "ns-3.awsdns-02.com", "ns-4.awsdns-03.co.uk"]
}
